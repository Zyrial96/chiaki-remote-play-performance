diff --git a/gui/include/videoframemailbox.h b/gui/include/videoframemailbox.h
new file mode 100644
index 0000000..a825ece
--- /dev/null
+++ b/gui/include/videoframemailbox.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#pragma once
+
+#include <chiaki/ffmpegdecoder.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+#include <utility>
+
+// Bounds the frame-thread -> GUI-thread handoff before the renderer's own queue.
+// The producer schedules a GUI callback only when push() returns true. That
+// callback takes the newest frame, rather than retaining one AVFrame per event.
+class VideoFrameMailbox
+{
+public:
+    struct Frame
+    {
+        ChiakiFfmpegFrame frame = {};
+        int32_t frames_lost = 0;
+        int64_t delivery_us = 0;
+
+        Frame() = default;
+        Frame(ChiakiFfmpegFrame frame, int32_t frames_lost, int64_t delivery_us)
+            : frame(frame), frames_lost(frames_lost), delivery_us(delivery_us) {}
+
+        ~Frame() { av_frame_free(&frame.frame); }
+        Frame(const Frame &) = delete;
+        Frame &operator=(const Frame &) = delete;
+
+        Frame(Frame &&other) noexcept
+            : frame(other.frame), frames_lost(other.frames_lost), delivery_us(other.delivery_us)
+        {
+            other.frame.frame = nullptr;
+        }
+
+        Frame &operator=(Frame &&other) noexcept
+        {
+            if (this != &other) {
+                av_frame_free(&frame.frame);
+                frame = other.frame;
+                frames_lost = other.frames_lost;
+                delivery_us = other.delivery_us;
+                other.frame.frame = nullptr;
+            }
+            return *this;
+        }
+
+        ChiakiFfmpegFrame release()
+        {
+            const ChiakiFfmpegFrame result = frame;
+            frame.frame = nullptr;
+            return result;
+        }
+    };
+
+    bool push(Frame incoming)
+    {
+        Frame discarded;
+        bool notify;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (!active || !incoming.frame.frame)
+                return false;
+            if (pending.frame.frame) {
+                // Preserve upstream loss and recovery information when replacing
+                // a frame, and count the superseded decoded frame exactly once.
+                const int64_t lost = static_cast<int64_t>(incoming.frames_lost)
+                    + pending.frames_lost + 1;
+                incoming.frames_lost = static_cast<int32_t>(std::min<int64_t>(
+                    lost, std::numeric_limits<int32_t>::max()));
+                incoming.frame.recovered = incoming.frame.recovered || pending.frame.recovered;
+            }
+            discarded = std::move(pending);
+            pending = std::move(incoming);
+            notify = !notification_pending;
+            notification_pending = true;
+        }
+        // Release superseded hardware/software buffers outside the mailbox lock.
+        return notify;
+    }
+
+    Frame take()
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        notification_pending = false;
+        return std::move(pending);
+    }
+
+    // Each streaming session uses a separate mailbox. Cancellation makes any
+    // already queued GUI callback harmless after session teardown/reconnect.
+    void cancel()
+    {
+        Frame discarded;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            active = false;
+            notification_pending = false;
+            discarded = std::move(pending);
+        }
+    }
+
+private:
+    std::mutex mutex;
+    Frame pending;
+    bool active = true;
+    bool notification_pending = false;
+};
diff --git a/gui/src/macVideoFrames.mm b/gui/src/macVideoFrames.mm
new file mode 100644
index 0000000..755e142
--- /dev/null
+++ b/gui/src/macVideoFrames.mm
@@ -0,0 +1,190 @@
+#import <CoreVideo/CoreVideo.h>
+#import <Metal/Metal.h>
+
+#define VK_USE_PLATFORM_METAL_EXT
+#include "macVideoFrames.h"
+
+#define PL_LIBAV_IMPLEMENTATION 0
+#include <libplacebo/utils/libav.h>
+
+extern "C" {
+#include <libavutil/frame.h>
+#include <libavutil/hwcontext.h>
+}
+
+#include <array>
+#include <deque>
+#include <limits>
+#include <memory>
+
+#if PL_API_VER >= 387 && defined(VK_EXT_metal_objects)
+namespace {
+struct ImportedFrame {
+    pl_gpu gpu;
+    AVFrame *source = nullptr;
+    std::array<CVMetalTextureRef, 2> views{};
+    std::array<pl_tex, 2> textures{};
+
+    explicit ImportedFrame(pl_gpu gpu) : gpu(gpu) {}
+    ~ImportedFrame()
+    {
+        for (size_t plane = 0; plane < textures.size(); ++plane) {
+            pl_tex_destroy(gpu, &textures[plane]);
+            if (views[plane])
+                CFRelease(views[plane]);
+        }
+        av_frame_free(&source);
+    }
+
+    bool busy() const
+    {
+        for (pl_tex texture : textures) {
+            if (pl_tex_poll(gpu, texture, 0))
+                return true;
+        }
+        return false;
+    }
+
+    void wait() const
+    {
+        for (pl_tex texture : textures) {
+            while (pl_tex_poll(gpu, texture, std::numeric_limits<uint64_t>::max())) {
+            }
+        }
+    }
+};
+}
+
+struct MacVideoFrames {
+    pl_gpu gpu;
+    CVMetalTextureCacheRef cache = nullptr;
+    std::unique_ptr<ImportedFrame> active;
+    std::deque<std::unique_ptr<ImportedFrame>> retired;
+
+    explicit MacVideoFrames(pl_gpu gpu) : gpu(gpu) {}
+    ~MacVideoFrames()
+    {
+        if (active || !retired.empty())
+            pl_gpu_finish(gpu);
+        active.reset();
+        retired.clear();
+        if (cache)
+            CFRelease(cache);
+    }
+};
+
+MacVideoFrames *createMacVideoFrames(pl_vulkan vulkan)
+{
+    if (!vulkan || !(vulkan->gpu->import_caps.tex & PL_HANDLE_MTL_TEX))
+        return nullptr;
+
+    auto exportObjects = reinterpret_cast<PFN_vkExportMetalObjectsEXT>(
+        vulkan->get_proc_addr(vulkan->instance, "vkExportMetalObjectsEXT"));
+    if (!exportObjects)
+        return nullptr;
+
+    @autoreleasepool {
+        VkExportMetalDeviceInfoEXT device{};
+        device.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT;
+        VkExportMetalObjectsInfoEXT info{};
+        info.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT;
+        info.pNext = &device;
+        exportObjects(vulkan->device, &info);
+        auto result = std::make_unique<MacVideoFrames>(vulkan->gpu);
+        if (!device.mtlDevice || CVMetalTextureCacheCreate(kCFAllocatorDefault, nullptr,
+                     device.mtlDevice, nullptr, &result->cache) != kCVReturnSuccess)
+            return nullptr;
+        return result.release();
+    }
+}
+
+void destroyMacVideoFrames(MacVideoFrames *frames)
+{
+    delete frames;
+}
+
+void retireMacVideoFrame(MacVideoFrames *frames)
+{
+    if (!frames || !frames->active)
+        return;
+
+    frames->retired.push_back(std::move(frames->active));
+    while (!frames->retired.empty() && !frames->retired.front()->busy())
+        frames->retired.pop_front();
+
+    // CoreVideo may recycle a decoder surface as soon as its AVFrame is released.
+    // Keep it until Vulkan finishes sampling, with a hard bound on decoder surfaces.
+    if (frames->retired.size() == 3) {
+        frames->retired.front()->wait();
+        frames->retired.pop_front();
+    }
+}
+
+bool importMacVideoFrame(MacVideoFrames *frames, AVFrame *source, pl_frame *mapped)
+{
+    if (!frames || !source->data[3] || !source->hw_frames_ctx)
+        return false;
+
+    auto buffer = reinterpret_cast<CVPixelBufferRef>(source->data[3]);
+    const OSType format = CVPixelBufferGetPixelFormatType(buffer);
+    const bool tenBit = format == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange ||
+                        format == kCVPixelFormatType_420YpCbCr10BiPlanarFullRange;
+    const bool fullRange = format == kCVPixelFormatType_420YpCbCr8BiPlanarFullRange ||
+                           format == kCVPixelFormatType_420YpCbCr10BiPlanarFullRange;
+    if ((!tenBit && !fullRange && format != kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange) ||
+        CVPixelBufferGetPlaneCount(buffer) != 2)
+        return false;
+
+    @autoreleasepool {
+        auto imported = std::make_unique<ImportedFrame>(frames->gpu);
+        imported->source = av_frame_clone(source);
+        if (!imported->source)
+            return false;
+
+        for (size_t plane = 0; plane < imported->textures.size(); ++plane) {
+            const bool luma = plane == 0;
+            const MTLPixelFormat metalFormat = tenBit
+                ? (luma ? MTLPixelFormatR16Unorm : MTLPixelFormatRG16Unorm)
+                : (luma ? MTLPixelFormatR8Unorm : MTLPixelFormatRG8Unorm);
+            const size_t width = CVPixelBufferGetWidthOfPlane(buffer, plane);
+            const size_t height = CVPixelBufferGetHeightOfPlane(buffer, plane);
+            if (CVMetalTextureCacheCreateTextureFromImage(kCFAllocatorDefault, frames->cache,
+                    buffer, nullptr, metalFormat, width, height, plane,
+                    &imported->views[plane]) != kCVReturnSuccess)
+                return false;
+
+            pl_tex_params params{};
+            params.w = static_cast<int>(width);
+            params.h = static_cast<int>(height);
+            params.format = pl_find_named_fmt(frames->gpu,
+                tenBit ? (luma ? "r16" : "rg16") : (luma ? "r8" : "rg8"));
+            params.sampleable = true;
+            params.import_handle = PL_HANDLE_MTL_TEX;
+            params.shared_mem.handle.handle = (__bridge void *)CVMetalTextureGetTexture(imported->views[plane]);
+            if (!params.format || !params.shared_mem.handle.handle)
+                return false;
+            imported->textures[plane] = pl_tex_create(frames->gpu, &params);
+            if (!imported->textures[plane])
+                return false;
+        }
+
+        // Use the actual CoreVideo format for the plane layout and bit alignment.
+        AVFrame description = *imported->source;
+        description.format = tenBit ? AV_PIX_FMT_P010LE : AV_PIX_FMT_NV12;
+        if (description.color_range == AVCOL_RANGE_UNSPECIFIED)
+            description.color_range = fullRange ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+        pl_frame_from_avframe(mapped, &description);
+        mapped->repr.bits.sample_depth = tenBit ? 16 : 8;
+        mapped->repr.bits.bit_shift = tenBit ? 6 : 0;
+        for (size_t plane = 0; plane < imported->textures.size(); ++plane)
+            mapped->planes[plane].texture = imported->textures[plane];
+        frames->active = std::move(imported);
+        return true;
+    }
+}
+#else
+MacVideoFrames *createMacVideoFrames(pl_vulkan) { return nullptr; }
+void destroyMacVideoFrames(MacVideoFrames *) {}
+bool importMacVideoFrame(MacVideoFrames *, AVFrame *, pl_frame *) { return false; }
+void retireMacVideoFrame(MacVideoFrames *) {}
+#endif
