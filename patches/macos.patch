+	ChiakiSession session;
+	ChiakiAudioReceiver receiver;
+	CapturedFrames audio;
+	CapturedFrames haptics;
+} AudioReceiverFixture;
+
+static void capture_frame(uint8_t *buf, size_t buf_size, void *user)
+{
+	CapturedFrames *captured = user;
+	munit_assert_size(captured->count, <, CAPTURED_FRAMES_MAX);
+	if(!buf)
+	{
+		munit_assert_size(buf_size, ==, 0);
+		captured->frames[captured->count++] = CONCEALED_FRAME;
+	}
+	else
+	{
+		munit_assert_size(buf_size, ==, 2);
+		captured->frames[captured->count++] = ((int)buf[0] << 8) | buf[1];
+	}
+}
+
+static void *fixture_setup(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = munit_malloc(sizeof(*fixture));
+	memset(fixture, 0, sizeof(*fixture));
+	fixture->session.log = get_test_log();
+	fixture->session.audio_sink.frame_cb = capture_frame;
+	fixture->session.audio_sink.user = &fixture->audio;
+	fixture->session.haptics_sink.frame_cb = capture_frame;
+	fixture->session.haptics_sink.user = &fixture->haptics;
+	munit_assert_int(chiaki_audio_receiver_init(&fixture->receiver, &fixture->session, NULL), ==, CHIAKI_ERR_SUCCESS);
+	return fixture;
+}
+
+static void fixture_teardown(void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	chiaki_audio_receiver_fini(&fixture->receiver);
+	free(fixture);
+}
+
+// The transport puts current source units first and copies of earlier frames afterwards.
+// Each synthetic encoded unit identifies its frame so the callback can check chronology
+// without involving an Opus decoder or an audio device.
+static void send_packet(AudioReceiverFixture *fixture, ChiakiSeqNum16 first_source,
+		uint8_t source_count, uint8_t fec_count, bool is_haptics)
+{
+	uint8_t data[2 * (15 + 15)];
+	munit_assert_uint8(source_count, <=, 15);
+	munit_assert_uint8(fec_count, <=, 15);
+	for(size_t i = 0; i < source_count + fec_count; i++)
+	{
+		ChiakiSeqNum16 frame = i < source_count ? first_source + i
+			: first_source - fec_count + (i - source_count);
+		data[2 * i] = (uint8_t)(frame >> 8);
+		data[2 * i + 1] = (uint8_t)frame;
+	}
+	ChiakiTakionAVPacket packet = { 0 };
+	packet.codec = 5;
+	packet.frame_index = first_source;
+	packet.is_haptics = is_haptics;
+	packet.units_in_frame_total = source_count + fec_count;
+	packet.units_in_frame_fec = (2 << 8) | (fec_count << 4) | source_count;
+	packet.data = data;
+	packet.data_size = 2 * packet.units_in_frame_total;
+	chiaki_audio_receiver_av_packet(&fixture->receiver, &packet);
+}
+
+static void prime_audio(AudioReceiverFixture *fixture, ChiakiSeqNum16 first)
+{
+	for(unsigned int i = 0; i < 3; i++)
+		send_packet(fixture, first + i, 1, 0, false);
+	munit_assert_size(fixture->audio.count, ==, 3);
+}
+
+static void assert_contiguous_audio(AudioReceiverFixture *fixture, ChiakiSeqNum16 first, size_t count)
+{
+	munit_assert_size(fixture->audio.count, ==, count);
+	for(size_t i = 0; i < count; i++)
+		munit_assert_int(fixture->audio.frames[i], ==, (ChiakiSeqNum16)(first + i));
+	munit_assert_size(fixture->haptics.count, ==, 0);
+}
+
+static MunitResult test_source_only(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	send_packet(fixture, 1, 1, 0, false);
+	send_packet(fixture, 2, 1, 0, false);
+	munit_assert_size(fixture->audio.count, ==, 0);
+	send_packet(fixture, 3, 1, 0, false);
+	assert_contiguous_audio(fixture, 1, 3);
+	send_packet(fixture, 4, 1, 0, false);
+	assert_contiguous_audio(fixture, 1, 4);
+	return MUNIT_OK;
+}
+
+static MunitResult test_recover_before_concealing(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	prime_audio(fixture, 1);
+	// Packet 4 was lost, but its complete encoded audio is already in packet 5.
+	send_packet(fixture, 5, 1, 2, false);
+	assert_contiguous_audio(fixture, 1, 5);
+	return MUNIT_OK;
+}
+
+static MunitResult test_multiple_source_and_redundant_units(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	prime_audio(fixture, 10);
+	// Recover 13 and 14 before delivering both new source frames, 15 and 16.
+	send_packet(fixture, 15, 2, 2, false);
+	assert_contiguous_audio(fixture, 10, 7);
+	return MUNIT_OK;
+}
+
+static MunitResult test_duplicate_and_late_packets(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	prime_audio(fixture, 1);
+	send_packet(fixture, 4, 1, 2, false);
+	send_packet(fixture, 4, 1, 2, false);
+	send_packet(fixture, 2, 1, 0, false);
+	send_packet(fixture, 5, 1, 2, false);
+	assert_contiguous_audio(fixture, 1, 5);
+	return MUNIT_OK;
+}
+
+static MunitResult test_conceal_only_unrecoverable_gap(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	prime_audio(fixture, 1);
+	// Packet 6 can recover frame 5, but frame 4 is genuinely unavailable.
+	send_packet(fixture, 6, 1, 1, false);
+	munit_assert_size(fixture->audio.count, ==, 6);
+	munit_assert_int(fixture->audio.frames[3], ==, CONCEALED_FRAME);
+	munit_assert_int(fixture->audio.frames[4], ==, 5);
+	munit_assert_int(fixture->audio.frames[5], ==, 6);
+	return MUNIT_OK;
+}
+
+static MunitResult test_recovery_across_sequence_wrap(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	prime_audio(fixture, 65532);
+	// The two redundant frames are 65535 and 0, followed by new frame 1.
+	send_packet(fixture, 1, 1, 2, false);
+	assert_contiguous_audio(fixture, 65532, 6);
+	return MUNIT_OK;
+}
+
+static MunitResult test_startup_ignores_nonexistent_redundancy(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	for(unsigned int i = 1; i <= 3; i++)
+		send_packet(fixture, i, 1, 3, false);
+	assert_contiguous_audio(fixture, 1, 3);
+	return MUNIT_OK;
+}
+
+static MunitResult test_reordered_startup(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	send_packet(fixture, 3, 1, 0, false);
+	send_packet(fixture, 1, 1, 0, false);
+	munit_assert_size(fixture->audio.count, ==, 0);
+	send_packet(fixture, 2, 1, 0, false);
+	assert_contiguous_audio(fixture, 1, 3);
+	return MUNIT_OK;
+}
+
+static MunitResult test_haptics_remain_source_first(const MunitParameter params[], void *user)
+{
+	AudioReceiverFixture *fixture = user;
+	send_packet(fixture, 3, 1, 2, true);
+	send_packet(fixture, 4, 1, 2, true);
+	munit_assert_size(fixture->haptics.count, ==, 2);
+	munit_assert_int(fixture->haptics.frames[0], ==, 3);
+	munit_assert_int(fixture->haptics.frames[1], ==, 4);
+	munit_assert_size(fixture->audio.count, ==, 0);
+	return MUNIT_OK;
+}
+
+#define AUDIO_TEST(name) { "/" #name, test_##name, fixture_setup, fixture_teardown, MUNIT_TEST_OPTION_NONE, NULL }
+
+MunitTest tests_audioreceiver[] = {
+	AUDIO_TEST(source_only),
+	AUDIO_TEST(recover_before_concealing),
+	AUDIO_TEST(multiple_source_and_redundant_units),
+	AUDIO_TEST(duplicate_and_late_packets),
+	AUDIO_TEST(conceal_only_unrecoverable_gap),
+	AUDIO_TEST(recovery_across_sequence_wrap),
+	AUDIO_TEST(startup_ignores_nonexistent_redundancy),
+	AUDIO_TEST(reordered_startup),
+	AUDIO_TEST(haptics_remain_source_first),
+	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
+};
