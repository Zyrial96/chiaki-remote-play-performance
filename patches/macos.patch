diff --git a/test/packetstats.c b/test/packetstats.c
new file mode 100644
index 0000000..67a4367
--- /dev/null
+++ b/test/packetstats.c
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include <munit.h>
+#include <chiaki/packetstats.h>
+
+static void expect_stats(ChiakiPacketStats *stats, bool reset, uint64_t expected_received, uint64_t expected_lost)
+{
+	uint64_t received, lost;
+	chiaki_packet_stats_get(stats, reset, &received, &lost);
+	munit_assert_uint64(received, ==, expected_received);
+	munit_assert_uint64(lost, ==, expected_lost);
+}
+
+static void start_before_wrap(ChiakiPacketStats *stats)
+{
+	munit_assert_int(chiaki_packet_stats_init(stats), ==, CHIAKI_ERR_SUCCESS);
+	for(uint32_t seq = 1; seq <= 65534; seq++)
+		chiaki_packet_stats_push_seq(stats, (ChiakiSeqNum16)seq);
+	expect_stats(stats, true, 65534, 0);
+}
+
+static MunitResult test_empty_and_generation(const MunitParameter params[], void *user)
+{
+	ChiakiPacketStats stats;
+	munit_assert_int(chiaki_packet_stats_init(&stats), ==, CHIAKI_ERR_SUCCESS);
+	expect_stats(&stats, false, 0, 0);
+	chiaki_packet_stats_push_generation(&stats, 70, 3);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	chiaki_packet_stats_push_seq(&stats, 3);
+	expect_stats(&stats, false, 72, 4);
+	expect_stats(&stats, true, 72, 4);
+	expect_stats(&stats, false, 0, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+static MunitResult test_reordered_packets(const MunitParameter params[], void *user)
+{
+	ChiakiPacketStats stats;
+	munit_assert_int(chiaki_packet_stats_init(&stats), ==, CHIAKI_ERR_SUCCESS);
+	chiaki_packet_stats_push_seq(&stats, 3);
+	expect_stats(&stats, false, 1, 2);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	chiaki_packet_stats_push_seq(&stats, 2);
+	expect_stats(&stats, true, 3, 0);
+	chiaki_packet_stats_push_seq(&stats, 4);
+	expect_stats(&stats, true, 1, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+static MunitResult test_duplicates_do_not_invent_loss(const MunitParameter params[], void *user)
+{
+	ChiakiPacketStats stats;
+	munit_assert_int(chiaki_packet_stats_init(&stats), ==, CHIAKI_ERR_SUCCESS);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	chiaki_packet_stats_push_seq(&stats, 2);
+	chiaki_packet_stats_push_seq(&stats, 2);
+	expect_stats(&stats, true, 3, 0);
+	chiaki_packet_stats_push_seq(&stats, 2);
+	expect_stats(&stats, true, 1, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+static MunitResult test_sequence_wrap_without_loss(const MunitParameter params[], void *user)
+{
+	ChiakiPacketStats stats;
+	start_before_wrap(&stats);
+	chiaki_packet_stats_push_seq(&stats, 65535);
+	chiaki_packet_stats_push_seq(&stats, 0);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	expect_stats(&stats, true, 3, 0);
+	chiaki_packet_stats_push_seq(&stats, 2);
+	expect_stats(&stats, true, 1, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+static MunitResult test_sequence_wrap_with_loss(const MunitParameter params[], void *user)
+{
+	ChiakiPacketStats stats;
+	start_before_wrap(&stats);
+	/* 65535 was lost; 0 and 1 arrived. */
+	chiaki_packet_stats_push_seq(&stats, 0);
+	chiaki_packet_stats_push_seq(&stats, 1);
+	expect_stats(&stats, true, 2, 1);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+static MunitResult test_long_stream_with_periodic_reporting(const MunitParameter params[], void *user)
+{
+	ChiakiPacketStats stats;
+	munit_assert_int(chiaki_packet_stats_init(&stats), ==, CHIAKI_ERR_SUCCESS);
+	uint64_t pending = 0;
+	for(uint32_t seq = 1; seq <= 200000; seq++)
+	{
+		chiaki_packet_stats_push_seq(&stats, (ChiakiSeqNum16)seq);
+		pending++;
+		if(seq % 17 == 0)
+		{
+			expect_stats(&stats, true, pending, 0);
+			pending = 0;
+		}
+	}
+	expect_stats(&stats, true, pending, 0);
+	chiaki_packet_stats_fini(&stats);
+	return MUNIT_OK;
+}
+
+MunitTest tests_packetstats[] = {
+	{ "/empty_and_generation", test_empty_and_generation, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/reordered_packets", test_reordered_packets, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/duplicates_do_not_invent_loss", test_duplicates_do_not_invent_loss, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/sequence_wrap_without_loss", test_sequence_wrap_without_loss, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/sequence_wrap_with_loss", test_sequence_wrap_with_loss, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ "/long_stream_with_periodic_reporting", test_long_stream_with_periodic_reporting, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL },
+	{ NULL, NULL, NULL, NULL, MUNIT_TEST_OPTION_NONE, NULL }
+};
diff --git a/test/videoframemailbox.cpp b/test/videoframemailbox.cpp
new file mode 100644
index 0000000..47c1118
--- /dev/null
+++ b/test/videoframemailbox.cpp
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include "videoframemailbox.h"
+
+extern "C" {
+#include <libavutil/buffer.h>
+#include <libavutil/mem.h>
+}
+
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+static void require(bool condition, const char *expression, int line)
+{
+    if (!condition)
+        throw std::runtime_error(std::string(expression) + " at line " + std::to_string(line));
+}
+#define CHECK(condition) require(condition, #condition, __LINE__)
+
+static void release_buffer(void *opaque, uint8_t *data)
+{
+    auto *released = static_cast<std::atomic<int> *>(opaque);
+    released->fetch_add(1);
+    av_free(data);
+}
+
+static VideoFrameMailbox::Frame make_frame(std::atomic<int> &released, int id,
+                                          int32_t lost = 0, bool recovered = false)
+{
+    ChiakiFfmpegFrame value = {};
+    value.frame = av_frame_alloc();
+    CHECK(value.frame != nullptr);
+    uint8_t *data = static_cast<uint8_t *>(av_malloc(1));
+    if (!data) {
+        av_frame_free(&value.frame);
+        throw std::runtime_error("av_malloc failed");
+    }
+    value.frame->buf[0] = av_buffer_create(data, 1, release_buffer, &released, 0);
+    if (!value.frame->buf[0]) {
+        av_free(data);
+        av_frame_free(&value.frame);
+        throw std::runtime_error("av_buffer_create failed");
+    }
+    value.frame->data[0] = data;
+    value.frame->pts = id;
+    value.pts = id;
+    value.duration = 1.0 / 60.0;
+    value.recovered = recovered;
+    return VideoFrameMailbox::Frame(value, lost, id * INT64_C(1000));
+}
+
+static void test_stalled_consumer_gets_newest()
+{
+    std::atomic<int> released{0};
+    VideoFrameMailbox mailbox;
+    CHECK(!mailbox.take().frame.frame);
+    int notifications = 0;
+    const int count = 600;
+    for (int i = 1; i <= count; ++i)
+        notifications += mailbox.push(make_frame(released, i, 0, i == 1));
+    CHECK(notifications == 1);
+    CHECK(released == count - 1);
+    auto delivery = mailbox.take();
+    CHECK(delivery.frame.frame->pts == count);
+    CHECK(delivery.frames_lost == count - 1);
+    CHECK(delivery.frame.recovered);
+    CHECK(delivery.delivery_us == count * INT64_C(1000));
+    CHECK(!mailbox.take().frame.frame);
+    ChiakiFfmpegFrame renderer_owned = delivery.release();
+    CHECK(!delivery.frame.frame);
+    CHECK(released == count - 1);
+    av_frame_free(&renderer_owned.frame);
+    CHECK(released == count);
+    CHECK(mailbox.push(make_frame(released, count + 1)));
+    mailbox.cancel();
+    CHECK(released == count + 1);
+}
+
+static void test_loss_and_recovery_metadata()
+{
+    std::atomic<int> released{0};
+    VideoFrameMailbox mailbox;
+    CHECK(mailbox.push(make_frame(released, 1, 2, true)));
+    CHECK(!mailbox.push(make_frame(released, 2, 3)));
+    auto delivery = mailbox.take();
+    CHECK(delivery.frames_lost == 6); // 2 upstream + 3 upstream + 1 replaced
+    CHECK(delivery.frame.recovered);
+    CHECK(delivery.frame.duration == 1.0 / 60.0);
+    CHECK(mailbox.push(make_frame(released, 3)));
+    auto next = mailbox.take();
+    CHECK(next.frames_lost == 0);
+    CHECK(!next.frame.recovered);
+
+    CHECK(mailbox.push(make_frame(released, 4, std::numeric_limits<int32_t>::max())));
+    CHECK(!mailbox.push(make_frame(released, 5, 1)));
+    CHECK(mailbox.take().frames_lost == std::numeric_limits<int32_t>::max());
+    delivery = VideoFrameMailbox::Frame();
+    next = VideoFrameMailbox::Frame();
+    CHECK(released == 5);
+}
+
+static void test_cancel_and_session_replacement()
+{
+    std::atomic<int> released{0};
+    auto old_session = std::make_shared<VideoFrameMailbox>();
+    CHECK(old_session->push(make_frame(released, 1)));
+    std::function<void()> queued_callback = [old_session]() {
+        CHECK(!old_session->take().frame.frame);
+    };
+    old_session->cancel();
+    CHECK(released == 1);
+    CHECK(!old_session->push(make_frame(released, 2)));
+    CHECK(released == 2);
+    old_session.reset();
+
+    auto new_session = std::make_shared<VideoFrameMailbox>();
+    CHECK(new_session->push(make_frame(released, 3)));
+    queued_callback();
+    CHECK(new_session->take().frame.frame->pts == 3);
+    CHECK(released == 3);
+
+    CHECK(new_session->push(make_frame(released, 4)));
+    new_session.reset(); // Context/callback destruction must also release pending frames.
+    CHECK(released == 4);
+}
+
+static void test_producer_consumer_race()
+{
+    const int count = 20000;
+    std::atomic<int> released{0};
+    VideoFrameMailbox mailbox;
+    std::mutex event_mutex;
+    std::condition_variable wake;
+    int queued_callbacks = 0;
+    int peak_callbacks = 0;
+    bool done = false;
+    int accounted_frames = 0;
+    int last_id = 0;
+    bool monotonic = true;
+    std::thread producer([&]() {
+        for (int id = 1; id <= count; ++id) {
+            if (mailbox.push(make_frame(released, id))) {
+                std::lock_guard<std::mutex> lock(event_mutex);
+                ++queued_callbacks;
+                peak_callbacks = std::max(peak_callbacks, queued_callbacks);
+                wake.notify_one();
+            }
+        }
+        std::lock_guard<std::mutex> lock(event_mutex);
+        done = true;
+        wake.notify_one();
+    });
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lock(event_mutex);
+            wake.wait(lock, [&]() { return queued_callbacks != 0 || done; });
+            if (queued_callbacks == 0)
+                break;
+            --queued_callbacks;
+        }
+        auto delivery = mailbox.take();
+        if (!delivery.frame.frame) {
+            monotonic = false;
+            continue;
+        }
+        const int id = static_cast<int>(delivery.frame.frame->pts);
+        monotonic = monotonic && id > last_id;
+        last_id = id;
+        accounted_frames += delivery.frames_lost + 1;
+        std::this_thread::yield();
+    }
+    producer.join();
+    CHECK(monotonic);
+    CHECK(last_id == count);
+    CHECK(accounted_frames == count);
+    CHECK(peak_callbacks == 1);
+    CHECK(released == count);
+}
+
+static void test_cancellation_race()
+{
+    const int count = 20000;
+    std::atomic<int> released{0};
+    VideoFrameMailbox mailbox;
+    std::atomic<bool> cancelled{false};
+    std::atomic<bool> done{false};
+    std::atomic<bool> valid{true};
+    std::mutex start_mutex;
+    std::condition_variable started;
+    bool producer_started = false;
+    std::thread producer([&]() {
+        for (int id = 1; id <= count; ++id) {
+            const bool after_cancel = cancelled.load();
+            const bool notify = mailbox.push(make_frame(released, id));
+            if (after_cancel && notify)
+                valid = false;
+            if (id == 1000) {
+                std::lock_guard<std::mutex> lock(start_mutex);
+                producer_started = true;
+                started.notify_one();
+            }
+        }
+        done = true;
+    });
+    std::thread consumer([&]() {
+        while (!done.load()) {
+            const bool after_cancel = cancelled.load();
+            auto delivery = mailbox.take();
+            if (after_cancel && delivery.frame.frame)
+                valid = false;
+            std::this_thread::yield();
+        }
+    });
+    {
+        std::unique_lock<std::mutex> lock(start_mutex);
+        started.wait(lock, [&]() { return producer_started; });
+    }
+    mailbox.cancel();
+    cancelled = true;
+    producer.join();
+    consumer.join();
+    CHECK(valid);
+    CHECK(!mailbox.take().frame.frame);
+    CHECK(released == count);
+}
