diff --git a/scripts/benchmark-videotoolbox.c b/scripts/benchmark-videotoolbox.c
new file mode 100644
index 0000000..6a865a4
--- /dev/null
+++ b/scripts/benchmark-videotoolbox.c
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// Scratch benchmark, not a player or end-to-end Remote Play latency test.
+/* macOS with Homebrew FFmpeg:
+ * clang -std=c11 -O2 -Wall -Wextra -Werror \
+ *   -I/opt/homebrew/opt/ffmpeg/include scripts/benchmark-videotoolbox.c \
+ *   -L/opt/homebrew/opt/ffmpeg/lib -lavutil -o /tmp/chiaki-vt-benchmark
+ * /tmp/chiaki-vt-benchmark
+ */
+
+#define _POSIX_C_SOURCE 200809L
+#include <libavutil/avutil.h>
+#include <libavutil/error.h>
+#include <libavutil/frame.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/pixdesc.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+enum { WIDTH = 1920, HEIGHT = 1080, POOL = 8, WARMUP = 50, SAMPLES = 400 };
+
+static int64_t now_ns(void)
+{
+    struct timespec value;
+    if (clock_gettime(CLOCK_MONOTONIC, &value) != 0) {
+        perror("clock_gettime");
+        exit(1);
+    }
+    return (int64_t)value.tv_sec * INT64_C(1000000000) + value.tv_nsec;
+}
+
+static void checked(int result, const char *operation)
+{
+    if (result >= 0)
+        return;
+    char error[AV_ERROR_MAX_STRING_SIZE];
+    av_strerror(result, error, sizeof(error));
+    fprintf(stderr, "%s: %s\n", operation, error);
+    exit(1);
+}
+
+static AVFrame *alloc_frame(void)
+{
+    AVFrame *frame = av_frame_alloc();
+    if (!frame) {
+        fprintf(stderr, "av_frame_alloc failed\n");
+        exit(1);
+    }
+    return frame;
+}
+
+static int row_bytes(enum AVPixelFormat format)
+{
+    return WIDTH * (format == AV_PIX_FMT_P010LE ? 2 : 1);
+}
+
+static void fill_frame(AVFrame *hardware, enum AVPixelFormat format, int id)
+{
+    AVFrame *mapped = alloc_frame();
+    checked(av_hwframe_map(mapped, hardware, AV_HWFRAME_MAP_WRITE | AV_HWFRAME_MAP_OVERWRITE), "write map");
+    for (int plane = 0; plane < 2; ++plane) {
+        const int rows = plane ? HEIGHT / 2 : HEIGHT;
+        if (!mapped->data[plane] || mapped->linesize[plane] < row_bytes(format)) {
+            fprintf(stderr, "Invalid writable VideoToolbox plane or stride\n");
+            av_frame_free(&mapped);
+            exit(1);
+        }
+        for (int row = 0; row < rows; ++row)
+            memset(mapped->data[plane] + (size_t)row * mapped->linesize[plane],
+                   (plane ? 0x80 : 0x20) + id, (size_t)row_bytes(format));
+    }
+    av_frame_free(&mapped);
+}
+
+static void verify_frame(const AVFrame *frame, enum AVPixelFormat format, int id)
+{
+    if (frame->format != format || frame->width != WIDTH || frame->height != HEIGHT) {
+        fprintf(stderr, "Incorrect mapped/copied format or dimensions\n");
+        exit(1);
+    }
+    for (int plane = 0; plane < 2; ++plane) {
+        const int rows = plane ? HEIGHT / 2 : HEIGHT;
+        const int bytes = row_bytes(format);
+        const uint8_t expected = (uint8_t)((plane ? 0x80 : 0x20) + id);
+        if (!frame->data[plane] || frame->linesize[plane] < bytes) {
+            fprintf(stderr, "Missing plane or invalid stride\n");
+            exit(1);
+        }
+        for (int row = 0; row < rows; row += rows - 1) {
+            const uint8_t *data = frame->data[plane] + (size_t)row * frame->linesize[plane];
+            if (data[0] != expected || data[bytes / 2] != expected || data[bytes - 1] != expected) {
+                fprintf(stderr, "Copied/mapped pixel validation failed\n");
+                exit(1);
+            }
+        }
+    }
+}
+
+static void check_retained_mapping(AVBufferRef *frames, enum AVPixelFormat format)
+{
+    AVFrame *source = alloc_frame();
+    checked(av_hwframe_get_buffer(frames, source, 0), "allocate lifetime-check frame");
+    fill_frame(source, format, 17);
+    AVFrame *mapped = alloc_frame();
+    checked(av_hwframe_map(mapped, source, AV_HWFRAME_MAP_READ), "lifetime-check map");
+    av_frame_free(&source);
+    AVFrame *retained = av_frame_clone(mapped);
+    if (!retained) {
+        fprintf(stderr, "clone mapped frame failed\n");
+        exit(1);
+    }
+    av_frame_free(&mapped);
+    verify_frame(retained, format, 17);
+    av_frame_free(&retained);
+}
+
+static int compare_ns(const void *left, const void *right)
+{
+    const int64_t a = *(const int64_t *)left;
+    const int64_t b = *(const int64_t *)right;
+    return (a > b) - (a < b);
+}
+
+static void print_distribution(int64_t *values)
+{
+    qsort(values, SAMPLES, sizeof(*values), compare_ns);
+    printf("{\"p50_us\":%.3f,\"p95_us\":%.3f,\"p99_us\":%.3f,\"max_us\":%.3f}",
+           values[SAMPLES / 2 - 1] / 1000.0, values[SAMPLES * 95 / 100 - 1] / 1000.0,
+           values[SAMPLES * 99 / 100 - 1] / 1000.0, values[SAMPLES - 1] / 1000.0);
+}
+
+static void benchmark_format(AVBufferRef *device, enum AVPixelFormat format)
+{
+    AVBufferRef *frames = av_hwframe_ctx_alloc(device);
+    if (!frames) {
+        fprintf(stderr, "av_hwframe_ctx_alloc failed\n");
+        exit(1);
+    }
+    AVHWFramesContext *context = (AVHWFramesContext *)frames->data;
+    context->format = AV_PIX_FMT_VIDEOTOOLBOX;
+    context->sw_format = format;
+    context->width = WIDTH;
+    context->height = HEIGHT;
+    context->initial_pool_size = POOL;
+    checked(av_hwframe_ctx_init(frames), "VideoToolbox frames context");
+
+    AVFrame *source[POOL];
+    for (int i = 0; i < POOL; ++i) {
+        source[i] = alloc_frame();
+        checked(av_hwframe_get_buffer(frames, source[i], 0), "allocate VideoToolbox frame");
+        fill_frame(source[i], format, i);
+    }
+    check_retained_mapping(frames, format);
+
+    int64_t setup[2][SAMPLES];
+    int64_t setup_and_release[2][SAMPLES];
+    for (int iteration = 0; iteration < WARMUP + SAMPLES; ++iteration) {
+        const int id = iteration % POOL;
+        // Alternate order in each pair; neither path always receives a warmer buffer.
+        for (int step = 0; step < 2; ++step) {
+            const int mapping = (iteration + step) % 2;
+            const int64_t begin = now_ns();
+            AVFrame *output = alloc_frame();
+            if (mapping) {
+                checked(av_hwframe_map(output, source[id], AV_HWFRAME_MAP_READ), "read-only map");
+            } else {
+                checked(av_hwframe_transfer_data(output, source[id], 0), "hardware-to-software copy");
+                checked(av_frame_copy_props(output, source[id]), "copy frame properties");
+            }
+            const int64_t prepared = now_ns();
+            // Verify without counting sampling/validation overhead as preparation cost.
+            verify_frame(output, format, id);
+            const int64_t release_begin = now_ns();
+            av_frame_free(&output);
+            const int64_t released = now_ns();
+            if (iteration >= WARMUP) {
+                const int sample = iteration - WARMUP;
+                setup[mapping][sample] = prepared - begin;
+                setup_and_release[mapping][sample] = prepared - begin + released - release_begin;
+            }
+        }
+    }
+    printf("{\"format\":\"%s\",\"width\":%d,\"height\":%d,\"pool_frames\":%d,"
+           "\"warmup_pairs\":%d,\"measured_pairs\":%d,\"retained_mapping_verified\":true,",
+           av_get_pix_fmt_name(format), WIDTH, HEIGHT, POOL, WARMUP, SAMPLES);
+    for (int mapping = 0; mapping < 2; ++mapping) {
+        printf("\"%s\":{\"prepare\":", mapping ? "readonly_map" : "copy");
+        print_distribution(setup[mapping]);
+        printf(",\"prepare_plus_release\":");
+        print_distribution(setup_and_release[mapping]);
+        printf("}%s", mapping ? "" : ",");
+    }
+    printf("}");
+    for (int i = 0; i < POOL; ++i)
+        av_frame_free(&source[i]);
+    av_buffer_unref(&frames);
+}
+
+int main(void)
+{
+    AVBufferRef *device = NULL;
+    checked(av_hwdevice_ctx_create(&device, AV_HWDEVICE_TYPE_VIDEOTOOLBOX, NULL, NULL, 0), "VideoToolbox device");
+    printf("{\"benchmark\":\"CPU preparation of allocated VideoToolbox frames; excludes decode, GPU upload, presentation and network\","
+           "\"ffmpeg_version\":\"%s\",\"libavutil_version\":%u,\"formats\":[", av_version_info(), avutil_version());
+    benchmark_format(device, AV_PIX_FMT_NV12);
+    printf(",");
+    benchmark_format(device, AV_PIX_FMT_P010LE);
+    printf("]}\n");
+    av_buffer_unref(&device);
+    return 0;
+}
