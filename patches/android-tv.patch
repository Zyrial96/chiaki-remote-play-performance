@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+// Exercise the production frame callback with real Chiaki/pthread mutexes and a
+// deterministic codec. No Android runtime, PS5, or account credentials required.
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifndef CHIAKI_AUDIO_DECODER_SOURCE
+#define CHIAKI_AUDIO_DECODER_SOURCE "../jni/audio-decoder.c"
+#endif
+#include CHIAKI_AUDIO_DECODER_SOURCE
+
+static uint8_t input_buffer[8];
+static uint8_t submitted[32];
+static size_t submitted_size;
+static int dequeue_calls, queue_calls, timeout_on_call;
+
+media_status_t AMediaCodec_delete(AMediaCodec *codec)
+{
+    (void)codec;
+    assert(!"the input test does not own a running codec");
+    return 0;
+}
+
+ssize_t AMediaCodec_dequeueInputBuffer(AMediaCodec *codec, int64_t timeout_us)
+{
+    assert(codec != NULL);
+    assert(timeout_us == 10000);
+    return ++dequeue_calls == timeout_on_call ? -1 : 0;
+}
+
+uint8_t *AMediaCodec_getInputBuffer(AMediaCodec *codec, size_t index, size_t *size)
+{
+    assert(codec != NULL && index == 0);
+    *size = sizeof(input_buffer);
+    return input_buffer;
+}
+
+media_status_t AMediaCodec_queueInputBuffer(AMediaCodec *codec, size_t index,
+    size_t offset, size_t size, uint64_t time_us, uint32_t flags)
+{
+    assert(codec != NULL && index == 0 && offset == 0 && flags == 0);
+    assert(size <= sizeof(input_buffer));
+    assert(submitted_size + size <= sizeof(submitted));
+    assert(time_us == (uint64_t)queue_calls);
+    memcpy(submitted + submitted_size, input_buffer, size);
+    submitted_size += size;
+    queue_calls++;
+    return 0;
+}
+
+struct LockProbe { ChiakiMutex *mutex; ChiakiErrorCode result; };
+
+static void *probe_from_other_thread(void *user)
+{
+    struct LockProbe *probe = user;
+    probe->result = chiaki_mutex_trylock(probe->mutex);
+    if(probe->result == CHIAKI_ERR_SUCCESS)
+        assert(chiaki_mutex_unlock(probe->mutex) == CHIAKI_ERR_SUCCESS);
+    return NULL;
+}
+
+static void assert_unlocked(ChiakiMutex *mutex)
+{
+    // A same-thread trylock cannot detect a leaked recursive lock. Use another
+    // thread, like session teardown or a later decoder reconfiguration would.
+    struct LockProbe probe = { .mutex = mutex, .result = CHIAKI_ERR_UNKNOWN };
+    ChiakiThread worker;
+    assert(chiaki_thread_create(&worker, probe_from_other_thread, &probe) == CHIAKI_ERR_SUCCESS);
+    assert(chiaki_thread_join(&worker, NULL) == CHIAKI_ERR_SUCCESS);
+    assert(probe.result == CHIAKI_ERR_SUCCESS);
+}
+
+static void run_case(const char *name, bool initialized, int timeout_at, size_t expected_bytes)
+{
+    ChiakiLog log;
+    chiaki_log_init(&log, 0, NULL, NULL);
+    AndroidChiakiAudioDecoder decoder = {0};
+    assert(android_chiaki_audio_decoder_init(&decoder, &log) == CHIAKI_ERR_SUCCESS);
+    decoder.codec = initialized ? (AMediaCodec *)&input_buffer : NULL;
+    uint8_t sample[16];
+    for(size_t i = 0; i < sizeof(sample); i++) sample[i] = (uint8_t)i;
+    dequeue_calls = queue_calls = 0;
+    submitted_size = 0;
+    timeout_on_call = timeout_at;
+
+    android_chiaki_audio_decoder_frame(sample, sizeof(sample), &decoder);
+    assert(submitted_size == expected_bytes);
+    assert(memcmp(sample, submitted, expected_bytes) == 0);
+    assert_unlocked(&decoder.codec_mutex);
+
+    decoder.codec = NULL;
+    android_chiaki_audio_decoder_fini(&decoder);
+    printf("PASS: %s\n", name);
+}
+
+int main(void)
+{
+    run_case("uninitialized codec", false, 0, 0);
+    run_case("timeout before first input buffer", true, 1, 0);
+    run_case("timeout after partial submission", true, 2, 8);
+    run_case("successful submission preserves samples", true, 0, 16);
+    return 0;
+}
