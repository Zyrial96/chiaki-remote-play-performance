+typedef struct video_output
+{
+	AndroidChiakiVideoDecoder *decoder;
+	size_t pending[2];
+	size_t count;
+	size_t presented;
+	size_t dropped;
+	int render_failures;
+	bool vsync_pending;
+	bool vsync_ready;
+} VideoOutput;
+
+// The callback is dispatched on the codec output thread's own looper.
+static void video_output_vsync(long frame_time, void *user)
+{
+	(void)frame_time;
+	VideoOutput *output = user;
+	output->vsync_pending = false;
+	output->vsync_ready = true;
+}
+
+static bool video_output_release(VideoOutput *output, size_t index, bool render)
+{
+	AndroidChiakiVideoDecoder *decoder = output->decoder;
+	if(__atomic_load_n(&decoder->shutdown_output, __ATOMIC_ACQUIRE))
+		return false;
+
+	render = render && __atomic_load_n(&decoder->surface_valid, __ATOMIC_ACQUIRE);
+	media_status_t status = AMediaCodec_releaseOutputBuffer(decoder->codec, index, render);
+	if(!render)
+		return true;
+	if(status == AMEDIA_OK)
+	{
+		output->presented++;
+		output->render_failures = 0;
+		return true;
+	}
+	if(++output->render_failures <= 30)
+		return true;
+	CHIAKI_LOGE(decoder->log, "Video Decoder output rendering failed %d times (%d), requesting codec recreation", output->render_failures, (int)status);
+	__atomic_store_n(&decoder->needs_recreate, true, __ATOMIC_RELEASE);
+	return false;
+}
+
+static bool video_output_pop(VideoOutput *output, bool render)
+{
+	size_t index = output->pending[0];
+	output->pending[0] = output->pending[1];
+	output->count--;
+	if(!render)
+		output->dropped++;
+	return video_output_release(output, index, render);
+}
