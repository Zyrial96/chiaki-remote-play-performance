+#!/usr/bin/env python3
+"""Host regression test of the real audio callback; requires cc and the core submodule.
+
+The NDK is stubbed only at the codec boundary. Chiaki mutexes use real pthreads.
+This does not replace an Android build or streaming test on physical hardware.
+Pass --source /path/to/audio-decoder.c to confirm an earlier source fails the test.
+"""
+from pathlib import Path
+import argparse
+import os
+import subprocess
+import tempfile
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--source", type=Path)
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[2]
+core = root / "external/chiaki-ng/lib"
+if not (core / "src/thread.c").exists():
+    parser.error("initialize external/chiaki-ng with git submodule update --init first")
+
+with tempfile.TemporaryDirectory(prefix="chiaki-audio-input-") as directory:
+    executable = Path(directory) / "audio-input-test"
+    command = [os.environ.get("CC", "cc"), "-std=gnu11", "-O1", "-g", "-pthread",
+               "-Wall", "-Wextra", "-ffunction-sections", "-fdata-sections",
+               "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-Wl,--gc-sections",
+               f"-I{root / 'native/tests/media-stubs'}", f"-I{root / 'native/jni'}",
+               f"-I{core / 'include'}"]
+    if args.source:
+        command.append(f'-DCHIAKI_AUDIO_DECODER_SOURCE="{args.source.resolve()}"')
+    command += [str(root / "native/tests/audio_decoder_input_test.c"),
+                str(core / "src/thread.c"), str(core / "src/time.c"), str(core / "src/log.c"),
+                "-o", str(executable)]
+    subprocess.run(command, check=True)
+    subprocess.run([str(executable)], check=True, timeout=10,
+                   env=dict(os.environ, UBSAN_OPTIONS="halt_on_error=1",
+                            # LeakSanitizer cannot run under some sandbox tracers.
+                            ASAN_OPTIONS=os.environ.get("ASAN_OPTIONS", "detect_leaks=0:abort_on_error=1")))
